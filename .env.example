# Skelpo CMS — example environment configuration.
# Copy to `.env` and edit. `.env` is gitignored.

# --- HTTP ---
PORT=3000
HOST=0.0.0.0
SITE_URL=http://localhost:3000

# --- Database (MySQL 8+ or MariaDB 11+) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=skelpo
DB_PASSWORD=skelpo
DB_NAME=skelpo
# DB_SSL=true            # uncomment for verify-full TLS

# --- Sessions ---
# 32-byte hex; generate with: openssl rand -hex 32
SESSION_SECRET=change_me_to_a_random_64_hex_value

# --- Email backend (one of: log, smtp, resend, postmark, ses) ---
EMAIL_BACKEND=log
EMAIL_FROM=hello@example.com
EMAIL_FROM_NAME=Skelpo CMS
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=
# POSTMARK_TOKEN=
# AWS_SES_REGION=

# --- Media storage (one of: local, s3) ---
MEDIA_BACKEND=local
MEDIA_LOCAL_PATH=./uploads
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=           # optional, for R2/MinIO

# --- imgproxy sidecar ---
IMGPROXY_URL=http://127.0.0.1:8080
IMGPROXY_SIGN_KEY=
IMGPROXY_SALT=

# --- Logging / observability ---
LOG_LEVEL=info
# METRICS_TOKEN=          # optional bearer for /metrics

# --- CORS ---
# CORS_ORIGINS=https://example.com,https://staging.example.com
