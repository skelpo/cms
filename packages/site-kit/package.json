{
  "name": "@skelpo/site-kit",
  "version": "0.1.1",
  "description": "Framework-agnostic SEO + structured-data helpers for Skelpo CMS customer frontends — sitemap, robots, llms.txt, RSS, JSON-LD. Works with Next.js, Hono, Astro, anything.",
  "license": "MIT",
  "author": "Skelpo GmbH <support@skelpo.com>",
  "homepage": "https://github.com/skelpo/cms/tree/main/packages/site-kit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skelpo/cms.git",
    "directory": "packages/site-kit"
  },
  "bugs": {
    "url": "https://github.com/skelpo/cms/issues"
  },
  "keywords": [
    "skelpo",
    "cms",
    "seo",
    "sitemap",
    "robots",
    "rss",
    "llms-txt",
    "json-ld",
    "structured-data",
    "i18n",
    "hreflang",
    "perry",
    "hono",
    "next"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "marked": "^18.0.4"
  }
}
