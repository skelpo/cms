{
  "name": "@skelpo/cms-client",
  "version": "0.1.0-pre",
  "description": "Typed client for Skelpo CMS — fetch content, settings, menus; submit forms; receive webhooks.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
