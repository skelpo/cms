{
  "name": "@skelpo/cms-client",
  "version": "0.1.1",
  "description": "Typed client for Skelpo CMS — fetch content, settings, menus; submit forms; verify webhooks. Works in Node, Bun, browsers, and Perry-compiled binaries.",
  "license": "MIT",
  "author": "Skelpo GmbH <support@skelpo.com>",
  "homepage": "https://github.com/skelpo/cms/tree/main/packages/cms-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skelpo/cms.git",
    "directory": "packages/cms-client"
  },
  "bugs": {
    "url": "https://github.com/skelpo/cms/issues"
  },
  "keywords": [
    "skelpo",
    "cms",
    "headless-cms",
    "client",
    "typescript",
    "api-client",
    "perry",
    "hono",
    "i18n"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
